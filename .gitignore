# Generated by Cargo
/target/

# Installed by bun. The built bundle is committed at assets/index.html, which
# the crate embeds; nothing else the build produces belongs in the repository.
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

.claude/settings.local.json

# Local Cargo configuration, where a [patch] stanza points a consumer's git
# dependency at this checkout. CI has no sibling checkout to point at.
.cargo/config.toml
